rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isCEOEmail(email) {
      return email != null && email.lower() in [
        'joaopedroalvesbarbosa08@gmail.com',
        'joaopedroalvesbarbbosa08@gmail.com',
        'andreiaalvesbarbosa06@gmail.com',
        'admuser'
      ];
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasRole(uid, role) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) && get(path).data.role == role;
    }

    function isCEO() {
      return isSignedIn() && (isCEOEmail(request.auth.token.email) || hasRole(request.auth.uid, 'CEO'));
    }

    function isADM() {
      return isSignedIn() && (isCEO() || hasRole(request.auth.uid, 'ADM'));
    }

    function isMOD() {
      return isSignedIn() && (isADM() || hasRole(request.auth.uid, 'MOD'));
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['CEO', 'ADM', 'MOD', 'USER'] &&
             data.createdAt is number &&
             data.get('level', 1) is number &&
             data.get('xp', 0) is number;
    }
    
    function isValidSave(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.game is string && data.game.size() <= 100 &&
             data.team is string && data.team.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidAppLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.user is string && data.user.size() <= 100 &&
             data.text is string && data.text.size() <= 5000 &&
             data.type in ['info', 'admin', 'error'] &&
             data.timestamp is number;
    }

    function isValidSystemUpdate(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 100 &&
             data.version is string && data.version.size() <= 20 &&
             data.description is string && data.description.size() <= 2000 &&
             data.date is number &&
             data.type in ['update', 'fix', 'news'];
    }

    function isValidWeeklyEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.startDate is number &&
             data.endDate is number &&
             data.isActive is bool &&
             data.type in ['challenge', 'community', 'news'];
    }

    function isValidHOF(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.saveId is string && data.saveId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.team is string && data.team.size() <= 100 &&
             data.titles is number &&
             data.seasons is number &&
             data.bestPlayer is string && data.bestPlayer.size() <= 100 &&
             data.reason is string && data.reason.size() <= 500 &&
             data.date is number;
    }

    function isValidPromoCode(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type in ['badge', 'role', 'level', 'status'] &&
             data.value is string && data.value.size() <= 100 &&
             data.uses is number &&
             data.maxUses is number &&
             data.createdBy is string && data.createdBy.size() <= 100 &&
             data.createdAt is number;
    }

    // --- RULES ---

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'USER' || (incoming().role == 'CEO' && isCEOEmail(incoming().email))
      );
      allow update: if (
        (isOwner(userId) && isValidUser(incoming()) && (
          // Protect immutables
          incoming().id == existing().id &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          // Role escalation protection: only CEOs can become CEOs
          (incoming().role == existing().role || (incoming().role == 'CEO' && isCEOEmail(incoming().email)))
        )) ||
        (isADM() && isValidUser(incoming()) && incoming().id == existing().id)
      );
      allow delete: if isCEO();
    }

    match /saves/{saveId} {
      allow read: if isSignedIn() && isValidId(saveId) && (resource.data.userId == request.auth.uid || isMOD());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isMOD());
      allow create: if isSignedIn() && isValidId(saveId) && isValidSave(incoming());
      allow update: if isSignedIn() && isValidId(saveId) && (
        (isOwner(existing().userId) && isValidSave(incoming())) ||
        (isADM() && incoming().diff(existing()).affectedKeys().hasOnly(['description']) && isValidSave(incoming()))
      );
      allow delete: if isSignedIn() && isValidId(saveId) && (isOwner(existing().userId) || isADM());
    }

    match /logs/{logId} {
      allow read: if isADM();
      allow list: if isADM();
      allow create: if (isADM() || (isSignedIn() && incoming().type == 'error')) && isValidId(logId) && isValidAppLog(incoming());
      allow update, delete: if isCEO();
    }

    match /system_updates/{updateId} {
      allow read: if true;
      allow write: if isCEO() && isValidId(updateId) && isValidSystemUpdate(incoming());
    }

    match /weekly_events/{eventId} {
      allow read: if true;
      allow write: if isADM() && isValidId(eventId) && isValidWeeklyEvent(incoming());
    }

    match /hall_of_fame/{entryId} {
      allow read: if true;
      allow write: if isADM() && isValidId(entryId) && isValidHOF(incoming());
    }

    match /codes/{codeId} {
      allow read: if isSignedIn();
      allow create, delete: if isCEO() && isValidId(codeId) && isValidPromoCode(incoming());
      allow update: if isSignedIn() && isValidId(codeId) && (
        (isCEO() && isValidPromoCode(incoming())) ||
        // Allow users to update "uses" when redeeming (limited to just that field)
        (incoming().diff(existing()).affectedKeys().hasOnly(['uses']) && incoming().uses == existing().uses + 1 && incoming().uses <= existing().maxUses)
      );
    }

    match /generator_lists/{listId} {
      allow read: if true;
      allow write: if isCEO() && isValidId(listId);
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId);
      allow read, list: if isMOD();
      allow update, delete: if isADM() && isValidId(reportId);
    }

    match /settings/global {
      allow read: if true;
      allow write: if isCEO();
    }

    match /official_challenges/{id} {
      allow read: if true;
      allow write: if isADM();
    }

    match /library_ideas/{id} {
      allow read: if true;
      allow write: if isADM();
    }

    match /community_tips/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isMOD() || isOwner(existing().authorId);
    }

    match /imported_careers/{id} {
      allow read: if true;
      allow write: if isADM();
    }
  }
}
