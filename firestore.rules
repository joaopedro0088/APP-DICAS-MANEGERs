rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isCEOEmail(email) {
      return email.lower() in [
        'joaopedroalvesbarbosa08@gmail.com',
        'joaopedroalvesbarbbosa08@gmail.com',
        'andreiaalvesbarbosa06@gmail.com',
        'admuser'
      ];
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function currentRole() {
      return getUserData(request.auth.uid).role;
    }
    
    function isCEO() { 
      return isSignedIn() && (currentRole() == 'CEO' || isCEOEmail(request.auth.token.email)); 
    }
    function isADM() { 
      return isSignedIn() && (currentRole() == 'ADM' || isCEO()); 
    }
    function isMOD() { 
      return isSignedIn() && (currentRole() == 'MOD' || isADM()); 
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['CEO', 'ADM', 'MOD', 'USER'] &&
             data.createdAt is number;
    }
    
    function isValidSave(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.game is string && data.game.size() <= 100 &&
             data.team is string && data.team.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidLog(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.version is string && data.version.size() <= 20 &&
             data.description is string && data.description.size() <= 2000 &&
             data.date is number;
    }

    // --- RULES ---

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'USER' || (incoming().role == 'CEO' && isCEOEmail(incoming().email))
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'bio', 'favoriteGames', 'favorites', 'updatedAt', 'role']) && isValidUser(incoming()) && (
          incoming().role == existing().role || isCEOEmail(incoming().email)
        )) ||
        (isADM() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'level', 'badges', 'name', 'bio', 'photoUrl']) && isValidUser(incoming()))
      );
      allow delete: if isCEO();
    }

    match /saves/{saveId} {
      allow read: if isSignedIn() && isValidId(saveId) && (resource.data.userId == request.auth.uid || isMOD());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isMOD());
      allow create: if isSignedIn() && isValidId(saveId) && isValidSave(incoming());
      allow update: if isSignedIn() && isValidId(saveId) && (
        (isOwner(existing().userId) && isValidSave(incoming())) ||
        (isADM() && incoming().diff(existing()).affectedKeys().hasOnly(['description']) && isValidSave(incoming()))
      );
      allow delete: if isSignedIn() && isValidId(saveId) && (isOwner(existing().userId) || isADM());
    }

    match /logs/{logId} {
      allow read: if true;
      allow write: if isCEO() && isValidId(logId) && isValidLog(incoming());
    }

    match /generator_lists/{listId} {
      allow read: if true;
      allow write: if isCEO() && isValidId(listId);
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId);
      allow read, list: if isMOD();
      allow update, delete: if isADM() && isValidId(reportId);
    }

    match /settings/global {
      allow read: if true;
      allow write: if isCEO();
    }

    match /official_challenges/{id} {
      allow read: if true;
      allow write: if isADM();
    }

    match /library_ideas/{id} {
      allow read: if true;
      allow write: if isADM();
    }

    match /community_tips/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isMOD() || isOwner(existing().authorId);
    }

    match /imported_careers/{id} {
      allow read: if true;
      allow write: if isADM();
    }
  }
}
